// examples/webapp.nct — Nect ile üretilen, tarayıcıda çalışan çizim uygulaması.
//
// Çalıştır:  ./target/release/nect run examples/webapp.nct
//
// Program, arayüzü HTML+CSS+JS olarak üretir ve sistem tarayıcısında açar.
// Kendisi tarayıcı olamaz ama her arayüz uygulaması bir sayfa dosyasıdır:
// `import "std/ui.nct"` sayfa iskeletini, Nect değerleri de içeriği sağlar.

import "std/ui.nct"

// Tuvalin üstündeki araç çubuğu: renk düğmeleri + temizle.
let swatch_colors = ["#e0e6f0", "#7aa2f7", "#9ece6a", "#f7768e", "#e0af68"]
let tools = ""
for color in swatch_colors {
    tools += ui_button(color, "setColor('" + color + "')")
}
tools += ui_button("Sil", "clearCanvas()")

// Uygulamanın gövdesi: tuval, araçlar ve küçük bir durum satırı.
// Tuval çizim mantığı sayfanın kendi JavaScript'i — Nect bunu üretir,
// tarayıcı çalıştırır; dilin işi arayüzü tarif etmek.
let body = (
    ui_heading(
        "Nect Paint",
        "import \"std/ui.nct\" ile üretilen tek dosyalık uygulama",
    )
    + "<canvas id='board' width='640' height='420'"
    + " style='width:100%;background:#0d0f16;border-radius:12px;cursor:crosshair'>"
    + "</canvas>
<p id='status' class='sub'>fareyle çiz</p>"
    + ui_row(tools)
    + "<script>
const board = document.getElementById('board');
const pen = board.getContext('2d');
let drawing = false;
let ink = '#e0e6f0';
function setColor(c) { ink = c; document.getElementById('status').textContent = 'renk: ' + c; }
function clearCanvas() { pen.clearRect(0, 0, board.width, board.height); }
function spot(e) {
  const r = board.getBoundingClientRect();
  return [e.clientX - r.left, e.clientY - r.top];
}
board.addEventListener('mousedown', e => { drawing = true; draw(e); });
board.addEventListener('mousemove', e => { if (drawing) { draw(e); } });
addEventListener('mouseup', () => { drawing = false; });
board.addEventListener('mouseleave', () => { drawing = false; });
function draw(e) {
  const at = spot(e);
  pen.fillStyle = ink;
  pen.beginPath();
  pen.arc(at[0], at[1], 3, 0, Math.PI * 2);
  pen.fill();
}
</script>
")

// Sayfayı üret, geçici dosyaya yaz ve tarayıcıda aç.
let path = ui_open("Nect Paint", body)
print("Uygulama tarayıcıda açıldı: " + path)
print("Kapatmak için sekmeyi kapatabilirsin.")
