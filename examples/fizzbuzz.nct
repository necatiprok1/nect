// FizzBuzz: the classic first program after "hello, world".
//
// Run it with:  nect run examples/fizzbuzz.nct

fn fizzbuzz(n) {
    if (n % 15 == 0) {
        return "FizzBuzz"
    } else if (n % 3 == 0) {
        return "Fizz"
    } else if (n % 5 == 0) {
        return "Buzz"
    }
    return str(n)
}

for n in range(1, 21) {
    print(fizzbuzz(n))
}

// Collect the labels instead of printing them, then summarise.
let labels = []
for n in range(1, 101) {
    push(labels, fizzbuzz(n))
}

let fizz = 0
let buzz = 0
for label in labels {
    if (label == "Fizz") {
        fizz += 1
    } else if (label == "Buzz") {
        buzz += 1
    }
}

print("1..100 contains " + str(fizz) + " Fizz and " + str(buzz) + " Buzz")
print("last five: " + join(slice(labels, -5), ", "))
