// Numerical integration: Riemann sum for the integral of x^2 from 0 to 1
// (analytical answer: 1/3). Uses the midpoint rule with a precomputed step
// size to avoid division in the inner loop.
// AI-relevant: numerical integration underlies Bayesian inference, variational
// methods, and probabilistic models where closed-form integrals don't exist.

fn integrate(n) {
    let sum = 0.0
    let h = 0.00001
    let i = 0
    let x = 0.0
    while (i < n) {
        x = (i + 0.5) * h
        sum = sum + x * x
        i = i + 1
    }
    return sum
}

let result = integrate(1000000)
print("numerical integration: " + str(result))