// Linear regression: batch gradient descent on y = mx + b.
// Uses multiplication by 0.001 to avoid division in the gradient,
// so it is JIT-compiled.
// AI-relevant: linear regression is the simplest ML model and the basis
// for understanding gradient descent, which trains all neural networks.

fn train_regression(n_samples, iterations, lr) {
    let m = 0.0
    let b = 0.0
    let i = 0
    let grad_m = 0.0
    let grad_b = 0.0
    let j = 0
    let x = 0.0
    let y = 0.0
    let pred = 0.0
    let error = 0.0
    while (i < iterations) {
        grad_m = 0.0
        grad_b = 0.0
        j = 0
        while (j < n_samples) {
            x = j * 0.01
            y = 2.0 * x + 3.0
            pred = m * x + b
            error = pred - y
            grad_m = grad_m + error * x
            grad_b = grad_b + error
            j = j + 1
        }
        // Average gradient (n_samples = 1000, so divide by 1000 = multiply by 0.001)
        m = m - lr * grad_m * 0.001
        b = b - lr * grad_b * 0.001
        i = i + 1
    }
    return m + b
}

let result = train_regression(1000, 2000, 0.01)
print("linear regression: " + str(result))