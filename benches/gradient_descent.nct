// Gradient descent: optimize f(x) = x^2 + 5*x + 6
// Gradient = 2*x + 5, update: x = x - lr * grad
// AI-relevant: gradient descent is the core optimization algorithm
// for training neural networks (SGD, the simplest optimizer).

fn gradient_descent(x0, lr, iterations) {
    let x = x0
    let grad = 0.0
    while (iterations > 0) {
        grad = 2.0 * x + 5.0
        x = x - lr * grad
        iterations = iterations - 1
    }
    return x
}

let result = gradient_descent(10.0, 0.01, 200000)
print("gradient_descent result: " + str(result))