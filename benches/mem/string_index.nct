# String indexing benchmark — exercises the get_index string path.
# Before the fix, every s[i] collected the entire string into a Vec<char>.
# This benchmark repeatedly indexes characters from a moderately large string,
# making the O(n) allocation per index visible.
let s = "The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog. The quick brown fox jumps over the lazy dog."
let total = 0
let i = 0
while i < len(s) {
    total = total + char_code(s[i])
    i = i + 1
}
print(total)