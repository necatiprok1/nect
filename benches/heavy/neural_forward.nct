// Forward pass of an 800-layer, 128-neuron, 512-input network
// (52M weighted sums). Without arrays each input is derived from its index.
// AI-relevant: inference cost in transformer and MLP stacks is dominated by
// exactly this loop.

fn dot_product(n_inputs, a_scale, b_scale) {
    let sum = 0.0
    let i = 0
    let a = 0.0
    let b = 0.0
    while (i < n_inputs) {
        a = a_scale + i * 0.001
        b = b_scale + i * 0.002
        sum = sum + a * b
        i = i + 1
    }
    return sum
}

let layers = 800
let neurons = 128
let n_inputs = 512
let total = 0.0
let layer = 0
let neuron = 0
while (layer < layers) {
    while (neuron < neurons) {
        total = total + dot_product(n_inputs, layer * 0.01, neuron * 0.01)
        neuron = neuron + 1
    }
    neuron = 0
    layer = layer + 1
}
print("neural forward total: " + str(total))
