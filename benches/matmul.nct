// Simulated matrix multiply: C[r,c] = sum_k A[r,k] * B[k,c]
// Without arrays, matrix elements are computed deterministically from
// indices. This is the core operation behind every deep learning framework
// (dense layers, attention, convolution via im2col).
// Uses 3 params (within MAX_ARITY=4).

fn matmul_element(r, c, size) {
    let sum = 0.0
    let k = 0
    let a = 0.0
    let b = 0.0
    while (k < size) {
        a = r * 0.0001 + k * 0.001
        b = k * 0.0001 + c * 0.001
        sum = sum + a * b
        k = k + 1
    }
    return sum
}

let size = 60
let total = 0.0
let r = 0
let c = 0
while (r < size) {
    while (c < size) {
        total = total + matmul_element(r, c, size)
        c = c + 1
    }
    c = 0
    r = r + 1
}
print("matmul total: " + str(total))