// Nested loop tensor contraction: sums over three nested loops to simulate
// a tensor operation. Pure arithmetic (* and +) in a deeply nested structure
// that mirrors the memory-bound triple loops in tensor libraries.
// AI-relevant: tensor contractions are the core of einsum operations in
// NumPy, JAX, and PyTorch's torch.einsum.

let n = 60
let total = 0.0
let i = 0
let j = 0
let k = 0
while (i < n) {
    while (j < n) {
        while (k < n) {
            total = total + (i + 1) * (j + 1) * (k + 1)
            k = k + 1
        }
        k = 0
        j = j + 1
    }
    j = 0
    i = i + 1
}
print("nested loop total: " + str(total))